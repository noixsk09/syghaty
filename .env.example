# صيغتي | Sayghty — مثال متغيرات البيئة (بدون أسرار حقيقية)
# انسخ هذا الملف إلى .env.local واملأ القيم الفعلية.

# ==============================
# Supabase — مطلوب لتشغيل التطبيق
# ==============================

# عنوان مشروع Supabase (عام)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# مفتاح anon العام فقط — لا تضع service role هنا أبدًا
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# مفتاح الخدمة — للخادم فقط (Server Actions / Route Handlers)
# لا تستورده في أي ملف يعمل على المتصفح
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# ==============================
# الذكاء الاصطناعي — اختياري
# بدونه يعمل التطبيق في الوضع التجريبي (demo)
# ==============================

# المزود: openai أو demo (الافتراضي عند غياب المفتاح)
AI_PROVIDER=openai

# مفتاح OpenAI — للخادم فقط
OPENAI_API_KEY=your-openai-api-key-server-only

# النموذج المستخدم (الافتراضي gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# ==============================
# إعدادات التطبيق
# ==============================
NEXT_PUBLIC_APP_NAME=صيغتي | Sayghty
NEXT_PUBLIC_APP_LOCALE=ar-EG
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Cairo

# رابط التطبيق الكامل — مطلوب في Vercel لـ metadataBase و redirects الصحيحة
# في بيئة الإنتاج: https://your-domain.vercel.app  أو النطاق المخصص
# في بيئة التطوير: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
